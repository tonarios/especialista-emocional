# Perfil de nube (Cloud Run). NO es un fichero de secretos: en producción todas
# estas variables las inyecta Terraform, y JWT_SECRET / ANALYTICS_SALT vienen de
# Secret Manager. Este ejemplo sirve para reproducir el perfil en local.
#
# Uso local (requiere `gcloud auth application-default login`):
#   cp .env.cloud.example .env.cloud && set -a && . ./.env.cloud && set +a

# ── Datos: Firestore en vez de Postgres (escala a cero) ────────────
STORAGE_BACKEND=firestore
FIRESTORE_DATABASE=(default)

# ── Modelos: los más baratos de Vertex ─────────────────────────────
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=3072

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=diplomado-499206
GOOGLE_CLOUD_LOCATION=us-central1

# ── Índice ─────────────────────────────────────────────────────────
# Construido con gemini-embedding-001 a 3072 dims: NO es intercambiable con el
# de bge-m3 (los vectores no son comparables). El corpus_hash lo detecta.
INDEX_DIR=data/index-vertex

# ── Analítica ──────────────────────────────────────────────────────
# Sin ANALYTICS_SALT no se emite nada: mejor perder analítica que escribir un
# identificador reversible. En Cloud Run la inyecta Secret Manager.
BQ_DATASET=ah_emociones_analytics
# ANALYTICS_SALT=<Secret Manager>
# JWT_SECRET=<Secret Manager>
