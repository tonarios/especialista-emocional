# ── LLM local (Ollama) ──────────────────────────────────────────
LLM_MODEL=ollama/gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (RAG) ────────────────────────────────────────────
EMBED_MODEL=bge-m3

# ── Secreto de firma JWT (OPCIONAL en local) ────────────────────
# Si no se define, se genera y persiste en app_config de PostgreSQL.
JWT_SECRET=

# ── Memoria persistente ─────────────────────────────────────────
# PostgreSQL: sesiones ADK + perfiles + usuarios + auditoría.
POSTGRES_DSN=

# ── Índice RAG ──────────────────────────────────────────────────
INDEX_DIR=data/index

# ── Entorno / límites de rate limit ─────────────────────────────
ENVIRONMENT=local
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_REGISTER_PER_MIN=10
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_API_PER_MIN=120
