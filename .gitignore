# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.uv/
.pytest_cache/

# Secrets — JAMÁS commitear
.env
.env.*
# ...pero el ejemplo del perfil de nube SÍ (no lleva valores, solo nombres).
!.env.cloud.example


# Índice RAG generado (regenerable con `python -m index`). Uno por espacio de
# embeddings: `index` = bge-m3 (1024), `index-vertex` = gemini-embedding-001 (3072).
data/index/
data/index-vertex/

# Outputs generados: se publican solo los que referencian los docs
# (docs/QA_report.md enlaza GIFs, stills y el PDF).
outputs/*
!outputs/evidence/
!outputs/gifs/
!outputs/reporte.pdf
# Los frames intermedios de los GIFs son ~55 MB y se regeneran con
# scripts/capture_evidence.py.
outputs/gifs/frames/

# OS
.DS_Store

# Infra local (el state contiene secretos en claro)
infra/terraform/.terraform/
# .terraform.lock.hcl SÍ se commitea: fija los hashes de los providers. Sin él,
# `terraform init` puede resolver una versión distinta a la auditada.
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
*.tfvars
